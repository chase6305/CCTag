{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "cctag",
  "maintainers": "alicevision-team@googlegroups.com",
  "description": "Computer vision library for detecting CCTag markers made up of concentric circles",
  "homepage": "https://github.com/alicevision/CCTag",
  "builtin-baseline": "f3e10653cc27d62a37a3763cd84b38bca07c6075",
  "documentation": "https://cctag.readthedocs.io/",
  "license": "MPL-2.0",
  "dependencies": [
    {
      "name": "boost-config",
      "version>=": "1.91.0"
    },
    "boost-exception",
    "boost-ptr-container",
    "boost-serialization",
    "boost-spirit",
    "boost-stacktrace",
    "eigen3",
    "opencv",
    "tbb"
  ],
  "default-features": [
    "apps",
    "tests"
  ],
  "features": {
    "apps": {
      "description": "Build the detection and regression applications",
      "dependencies": [
        "boost-program-options"
      ]
    },
    "tests": {
      "description": "Build the unit tests",
      "dependencies": [
        "boost-test"
      ]
    }
  }
}
